{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "thsconline",
  "pages_build_output_dir": "dist",

  "services": [
    {
      "binding": "B2_WORKER",
      "service": "b2-proxy"
    }
  ],

  "secrets": {
    "required": [
      "GIT_TOKEN"
    ]
  },

  "vars": {
    "SYNCED_REPOS": "s,pdf",
    "GITHUB_DOMAIN": "thsconline.github.io",
    "CF_DOMAIN": "www.thsconline.net"
  }
}
